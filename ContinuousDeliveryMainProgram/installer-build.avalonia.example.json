{
  "UIFramework": "Avalonia", // 可选 Wpf 或 Avalonia；决定图片资源类型和 UseWPF
  // 输入路径相对于本配置文件；安装包默认输出到仓库根目录的 Output。
  "PayloadDirectory": "../Payload", // 要装到目标机器上的文件目录，不能与安装项目目录重叠
  "ConfigPath": "./InstallerProductInfo.json", // 安装程序读取的产品信息文件
  "UninstallerConfigPath": "./UninstallerConfig.json", // 使用 WPF 卸载器模板，与安装器界面框架独立；null 表示不生成
  "UpdaterConfigPath": "./UpdaterConfig.json", // 使用 WPF 更新器模板；null 表示不生成
  "IconPath": "../Payload/install.ico", // 放在待安装程序目录中的安装图标
  "LogoPath": "../Payload/installLogo.png", // 放在待安装程序目录中的安装界面图片

  "Project": {
    "AssemblyName": "InstallProgramAvalonia", // 生成的 EXE 名称，不含 .exe；null 表示沿用项目值
    "RootNamespace": "InstallProgramAvalonia", // 资源名称的命名空间前缀；null 表示沿用项目值
    "TargetFramework": "net10.0", // 目标框架，需要安装对应 .NET SDK
  },

  "Resources": {
    // 以下名称相对于安装项目目录；每项只能是单个名称，不能包含目录分隔符。
    // 更改清单、配置、Logo 名称或命名空间后，安装程序读取资源的代码也必须对应修改。
    "ConfigFileName": "InstallerProductInfo.json", // ConfigPath 复制后的名称
    "IconFileName": "install.ico", // 安装程序图标复制后的名称，同时写入 ApplicationIcon
    "LogoFileName": "installLogo.png", // Logo 复制后的名称
    "ExcludedExtensions": [".pdb"] // 不打包的扩展名，忽略大小写；[] 表示不过滤
  }
}





