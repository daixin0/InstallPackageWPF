        <LinearGradientBrush x:Key="backgroundColor">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#4F98EF" Offset="100"/>
                <GradientStop Color="#3F7ABF" Offset="100"/>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <!--Colors-->
        <SolidColorBrush x:Key="themeColor" Color="#4F98EF"/>
        <SolidColorBrush x:Key="whiteColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="lightGray"  Color="#6F6F6F"/>
        <SolidColorBrush x:Key="lightGreen" Color="#64D7B9"/>
        <SolidColorBrush x:Key="gray" Color="#E3E3E3"/>

        <converter:InstallStateConverter x:Key="installConvert"></converter:InstallStateConverter>
    </lib:ChildWindow.Resources>
    <Grid Margin="10" Effect="{DynamicResource ShadowWindow}">
        <!--安装前-->
        <Grid Visibility="{Binding CurrentSetupState,Converter={StaticResource installConvert},ConverterParameter={x:Static local:SetupState.Default}}" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="180"/>
                <RowDefinition MinHeight="114"/>
                <RowDefinition MinHeight="10"/>
            </Grid.RowDefinitions>
            <Grid Background="{DynamicResource backgroundColor}">
                <WrapPanel VerticalAlignment="Center"
                       HorizontalAlignment="Center">
                    <Image Source="installLogo.png" Width="60" Height="60"></Image>
                    <TextBlock Text="{Binding InstallTitle}"
                           Margin="18 0 0 0" Foreground="White" VerticalAlignment="Center" FontSize="24"/>
                </WrapPanel>
            </Grid>
            <Button Content="快速安装"
                        Grid.Row="1"
                        Margin="0 30 0 0" Width="180" Height="36"
                        VerticalAlignment="Top" FontSize="16"
                        Click="btnInstall_Click"
                        Foreground="{StaticResource whiteColor}"
                        Background="{StaticResource themeColor}"/>
            <DockPanel Grid.Row="2" VerticalAlignment="Bottom"
                       Margin="14 0 14 14">
                <CheckBox VerticalContentAlignment="Center" IsChecked="{Binding IsAgree,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                         Height="18">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="已阅读并同意"
                                   Foreground="{StaticResource lightGray}"/>
                        <Button Content="《BIM插件》"
                                 Click="btnUserAgreement_Click"
                                Foreground="{StaticResource themeColor}"
                                Style="{StaticResource LinkButtonStyle}"
                                VerticalAlignment="Bottom"/>
                        <TextBlock Text="的" Foreground="{StaticResource lightGray}"/>
                        <Button Content="用户许可协议"
                                 Click="btnUserAgreement_Click"
                                Style="{StaticResource LinkButtonStyle}"
                                VerticalAlignment="Bottom"
                                Foreground="{StaticResource themeColor}"/>
                    </WrapPanel>
                </CheckBox>
                <Button HorizontalAlignment="Right" 
                        Padding="0 0 4 0" Click="btnCustomSetup_Click">
                    <Button.Content>
                        <WrapPanel>
                            <TextBlock Foreground="#6F6F6F"
                                       Text="自定义安装"/>
                            <Path Stretch="Uniform"
                                  Margin="4 0 0 0"
                                  Height="8"
                                  Width="5"
                                  Fill="{StaticResource lightGray}"
                                Data="M0.146447 0.146447C-0.0488155 0.341709 -0.0488155 0.658291 0.146447 0.853553L3.29289 4L0.146447 7.14645C-0.0488152 7.34171 -0.0488152 7.65829 0.146447 7.85355C0.341709 8.04882 0.658292 8.04882 0.853554 7.85355L4.35355 4.35355C4.54882 4.15829 4.54882 3.84171 4.35355 3.64645L0.853553 0.146447C0.658291 -0.0488155 0.341709 -0.0488155 0.146447 0.146447Z"/>
                        </WrapPanel>
                    </Button.Content>
                </Button>
            </DockPanel>
        </Grid>
        <!--安装中-->
        <Grid Visibility="{Binding CurrentSetupState,Converter={StaticResource installConvert},ConverterParameter={x:Static local:SetupState.SetupProgress}}" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="144"/>
            </Grid.RowDefinitions>
            <Grid Background="{DynamicResource backgroundColor}">
                <StackPanel VerticalAlignment="Center"
                       HorizontalAlignment="Center">
                    <TextBlock Text="感谢您使用"
                           FontSize="24" Foreground="White" FontWeight="Bold"/>
                    <TextBlock Text="拼命安装中..."
                               Margin="0 6 0 0" FontSize="14" HorizontalAlignment="Center"
                               Foreground="{StaticResource whiteColor}"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" VerticalAlignment="Center"
                        Margin="20 0">
                <TextBlock  FontSize="14"
                               Foreground="#6F6F6F"
                           HorizontalAlignment="Left">
                    <TextBlock Text="{Binding InstallProgressDesc}"/>
                    <TextBlock Text="{Binding InstallProgress}"/>
                    <TextBlock Text="%"/>
                </TextBlock>
                <ProgressBar Margin="0 8 0 0" Height="10" Width="400"
                             Value="{Binding InstallProgress}"
                             Minimum="0"
                             Maximum="100"/>
            </StackPanel>
        </Grid>

        <!--安装完成-->
        <Grid Visibility="{Binding CurrentSetupState,Converter={StaticResource installConvert},ConverterParameter={x:Static local:SetupState.SetupComplete}}"  Background="White">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="144"/>
            </Grid.RowDefinitions>
            <Grid Background="{DynamicResource backgroundColor}">
                <StackPanel VerticalAlignment="Center"
                       HorizontalAlignment="Center">
                    <WrapPanel VerticalAlignment="Center" >
                        <Viewbox Height="32" VerticalAlignment="Center"
                                 Width="32">
                            <Grid>
                                <Path Style="{x:Null}"
                                      Stretch="Fill"
                                      Width="32"
                                      Height="32"
                                    Data="M15.9998 2.66602C23.3636 2.66602 29.3332 8.63555 29.3332 15.9993C29.3332 23.3631 23.3636 29.3327 15.9998 29.3327C8.63604 29.3327 2.6665 23.3631 2.6665 15.9993C2.6665 8.63555 8.63604 2.66602 15.9998 2.66602Z" Fill="#7DD75A"/>
                                <Path Style="{x:Null}"
                                      Stretch="Fill"
                                      Width="12"
                                      Height="9"
                                    Data="M19.893 12.0253L13.9334 17.9849L11.3072 15.3586C10.9167 14.9681 10.2835 14.9681 9.89299 15.3586C9.50247 15.7492 9.50247 16.3823 9.89299 16.7729L13.2263 20.1062C13.6168 20.4967 14.25 20.4967 14.6405 20.1062L21.3072 13.4395C21.6977 13.049 21.6977 12.4158 21.3072 12.0253C20.9167 11.6348 20.2835 11.6348 19.893 12.0253Z" Fill="white"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="安装完成"
                               Margin="15 -5 0 0"
                                   FontSize="25"
                               VerticalAlignment="Center" 
                           Foreground="White" FontWeight="Regular"/>
                    </WrapPanel>
                    <TextBlock Text="尽情使用吧!"
                               Margin="0 10 0 0"
                               FontSize="14" FontWeight="ExtraLight"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource whiteColor}"/>
                </StackPanel>
            </Grid>
            <Button Grid.Row="1" Background="{StaticResource themeColor}" Click="btnComplete_Click"
                    Width="180" Height="36" Foreground="White" FontSize="16"
                    Content="运行插件"/>
        </Grid>

        <!--自定义安装-->
        <Grid Visibility="{Binding CurrentSetupState,Converter={StaticResource installConvert},ConverterParameter={x:Static local:SetupState.CustomPath}}" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="180"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Background="{DynamicResource backgroundColor}">
                <WrapPanel VerticalAlignment="Center"
                       HorizontalAlignment="Center">
                    <Image Source="installLogo.png" Width="60" Height="60"></Image>
                    <TextBlock Text="{Binding InstallTitle}"
                           Margin="18 0 0 0" VerticalAlignment="Center"
                           FontSize="24" Foreground="White"/>
                </WrapPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="18 18 18 12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="安装位置:"
                           Foreground="#6F6F6F" FontSize="12"
                           HorizontalAlignment="Left"/>
                <Grid Grid.Row="2" Height="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox BorderBrush="{StaticResource gray}" TextChanged="TextBox_TextChanged" Text="{Binding InstallPath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2"
                            Width="58" BorderBrush="#6F6F6F" Click="btnSelectFolder_Click"
                            Content="浏览..." BorderThickness="1"
                            Foreground="#6F6F6F" FontSize="12"/>
                </Grid>
                <TextBlock Grid.Row="4" HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                    Foreground="#6F6F6F" FontSize="10">
                        <TextBlock Text="所需磁盘空间:"/>
                        <TextBlock Text="{Binding RequiredDiskSize}"/>
                    <TextBlock Margin="60 0 0 0"
                               Text="可用磁盘空间:" Foreground="#6F6F6F" FontSize="10"/>
                               <TextBlock Text="{Binding DiskSize}" Foreground="{Binding ColorDisk}"/>
                    </TextBlock>
                <DockPanel Grid.Row="6" HorizontalAlignment="Right"
                           VerticalAlignment="Bottom">
                    <Button 
                            Content="返回" Click="btnCancl_Click"
                            Width="72" BorderBrush="#EAEAEA"
                            Height="24" Foreground="#323232"
                            VerticalAlignment="Bottom"/>
                    <Button 
                            Background="{StaticResource themeColor}"
                            Width="72"
                            Margin="12 0 0 0"
                            Content="立即安装" Click="btnInstall_Click"
                            Foreground="{StaticResource whiteColor}"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</lib:ChildWindow>
