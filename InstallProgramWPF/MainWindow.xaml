        xmlns:local="clr-namespace:InstallProgramWPF"
        mc:Ignorable="d" Loaded="ChildWindow_Loaded" 
        ResizeMode="CanMinimize"
        Background="Transparent"         
        WindowStartupLocation="CenterScreen"
        Title="{Binding InstallTitle}" Height="364" Width="476">
